<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Barre du haut : Demandes à gauche, Réglages à droite -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/history_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-10dp"
                android:clickable="true"
                android:contentDescription="@string/history"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_clock" />

            <ImageView
                android:id="@+id/settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-10dp"
                android:clickable="true"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_sliders" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Héros -->
        <sn.flammesnap.FlameView
            android:id="@+id/flame"
            android:layout_width="match_parent"
            android:layout_height="150dp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="-0.035"
            android:lineSpacingMultiplier="0.92"
            android:tag="display"
            android:text="@string/main_title"
            android:textColor="@color/label"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:lineSpacingExtra="3dp"
            android:text="@string/main_subtitle"
            android:textColor="@color/secondary"
            android:textSize="17sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3" />

        <!-- Saisie + bouton Coller -->
        <FrameLayout
            android:id="@+id/input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <EditText
                android:id="@+id/friend_input"
                style="@style/Field"
                android:hint="@string/friend_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:paddingEnd="54dp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/paste_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:contentDescription="@string/paste"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_paste" />
        </FrameLayout>

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/secondary"
            android:textSize="13sp" />

        <!-- Amis récents -->
        <LinearLayout
            android:id="@+id/recents_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:text="@string/recents"
                android:textColor="@color/secondary"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-24dp"
                android:layout_marginEnd="-24dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Détails facultatifs (repliés) -->
        <LinearLayout
            android:id="@+id/details_toggle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="medium"
                android:text="@string/details_toggle"
                android:textColor="@color/secondary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/details_chevron"
                android:layout_width="8dp"
                android:layout_height="13dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/days_input"
                style="@style/Field"
                android:hint="@string/days_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:text="@string/lost"
                android:textColor="@color/secondary"
                android:textSize="13sp" />

            <sn.flammesnap.Segmented
                android:id="@+id/lost_segmented"
                android:layout_width="match_parent"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/details_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/details_note"
                android:textColor="@color/secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/continue_button"
            style="@style/PrimaryButton"
            android:layout_marginTop="10dp"
            android:tag="semibold"
            android:text="@string/continue_btn" />

        <!-- Profil actif : touche pour ouvrir les Réglages -->
        <LinearLayout
            android:id="@+id/profile_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <FrameLayout
                android:id="@+id/profile_avatar_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/profile_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
